# ---------------- Storage ----------------
_storage_key: Optional[str] = None

def init_storage():
    global _storage_key
    if _storage_key:
        return _storage_key
    if not EMERGENT_KEY:
        raise RuntimeError("EMERGENT_LLM_KEY missing")
    resp = requests.post(f"{STORAGE_URL}/init", json={"emergent_key": EMERGENT_KEY}, timeout=30)
    resp.raise_for_status()
    _storage_key = resp.json()["storage_key"]
    return _storage_key

def put_object(path: str, data: bytes, content_type: str) -> dict:
    key = init_storage()
    resp = requests.put(f"{STORAGE_URL}/objects/{path}",
                        headers={"X-Storage-Key": key, "Content-Type": content_type},
                        data=data, timeout=120)
    resp.raise_for_status()
    return resp.json()

def get_object(path: str):
    key = init_storage()
    resp = requests.get(f"{STORAGE_URL}/objects/{path}", headers={"X-Storage-Key": key}, timeout=60)
    resp.raise_for_status()
    return resp.content, resp.headers.get("Content-Type", "application/octet-stream")

# ---------------- Helpers ----------------
def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()

def new_id(prefix: str) -> str:
    return f"{prefix}_{uuid.uuid4().hex[:12]}"

def parse_dt(v):
    if isinstance(v, datetime):
        if v.tzinfo is None:
            v = v.replace(tzinfo=timezone.utc)
        return v
    if isinstance(v, str):
        d = datetime.fromisoformat(v.replace('Z', '+00:00'))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return d
    return None

def clean_doc(d):
    if not d:
        return d
    d.pop('_id', None)
    return d

# ---------------- Points engine ----------------
def retention_mult(p: float) -> float:
    if p < 20: return 0.8
    if p < 35: return 1.0
    if p < 50: return 1.2
    if p < 65: return 1.4
    if p < 80: return 1.5
    return 1.6

def engagement_mult(p: float) -> float:
    if p < 1: return 0.95
    if p < 3: return 1.0
    if p < 5: return 1.1
    if p < 8: return 1.15
    if p < 12: return 1.2
    return 1.25

def hit_mult(views: int) -> float:
    if views >= 1_000_000: return 1.50
    if views >= 500_000:   return 1.25
    if views >= 100_000:   return 1.10
    if views >= 50_000:    return 1.05
    return 1.0

def calc_points(views: int, retention_pct: float, engagement_pct: float):
    rm = retention_mult(retention_pct)
    em = engagement_mult(engagement_pct)
    hm = hit_mult(views)
    pts = float(views) * rm * em * hm
    return {"points": round(pts, 2), "retention_mult": rm, "engagement_mult": em, "hit_mult": hm}

# ---------------- YouTube ----------------
YT_ID_RE = re.compile(r"(?:youtube\.com/(?:shorts/|watch\?v=)|youtu\.be/)([A-Za-z0-9_-]{11})")
YT_CHANNEL_HANDLE_RE = re.compile(r"youtube\.com/@([A-Za-z0-9._-]+)")
YT_CHANNEL_ID_RE = re.compile(r"youtube\.com/channel/(UC[A-Za-z0-9_-]{22})")

def yt_video_id(url: str) -> Optional[str]:
    m = YT_ID_RE.search(url or "")
    return m.group(1) if m else None

def fetch_youtube_channel(url_or_handle: str):
    """Fetch channel info by URL/@handle/UC id. Falls back to manual storage if API key absent."""
    s = (url_or_handle or "").strip()
    if not s:
        return None
    handle = None
    channel_id = None
    m = YT_CHANNEL_ID_RE.search(s)
    if m:
        channel_id = m.group(1)
    else:
        m = YT_CHANNEL_HANDLE_RE.search(s)
        if m:
            handle = m.group(1)
        elif s.startswith("@"):
            handle = s[1:]
        elif s.startswith("UC") and len(s) >= 24:
            channel_id = s[:24]

    if not YOUTUBE_API_KEY:
        # Fallback: trust user input, no verification
        return {
            "channel_id": channel_id, "handle": handle, "title": handle or "YouTube Channel",
            "thumbnail": None, "url": s if s.startswith("http") else (f"https://youtube.com/@{handle}" if handle else None),
            "verified": False,
        }
    try:
        params = {"part": "snippet,statistics", "key": YOUTUBE_API_KEY}
        if channel_id:
            params["id"] = channel_id
        elif handle:
            params["forHandle"] = "@" + handle
        else:
            return None
        r = requests.get("https://www.googleapis.com/youtube/v3/channels", params=params, timeout=15)
        r.raise_for_status()
        items = r.json().get("items", [])
        if not items:
            return None
        it = items[0]
        sn = it.get("snippet", {})
        st = it.get("statistics", {})
        ch_id = it.get("id")
        return {
            "channel_id": ch_id, "handle": sn.get("customUrl", handle),
            "title": sn.get("title", ""),
            "thumbnail": (sn.get("thumbnails") or {}).get("default", {}).get("url"),
            "url": f"https://youtube.com/channel/{ch_id}",
            "subscribers": int(st.get("subscriberCount", 0)) if not st.get("hiddenSubscriberCount") else None,
            "verified": True,
        }
    except Exception as e:
        logger.warning(f"YouTube channel fetch failed: {e}")
        return None

def fetch_youtube_stats(url: str):
    vid = yt_video_id(url)
    if not vid or not YOUTUBE_API_KEY:
        return None
    try:
        r = requests.get("https://www.googleapis.com/youtube/v3/videos",
                         params={"id": vid, "part": "statistics,snippet", "key": YOUTUBE_API_KEY},
                         timeout=15)
        r.raise_for_status()
        items = r.json().get("items", [])
        if not items:
            return None
        s = items[0].get("statistics", {})
        sn = items[0].get("snippet", {})
        return {
            "video_id": vid,
            "title": sn.get("title", ""),
            "channel_id": sn.get("channelId"),
            "channel_title": sn.get("channelTitle"),
            "views": int(s.get("viewCount", 0)),
            "likes": int(s.get("likeCount", 0)),
            "comments": int(s.get("commentCount", 0)),
        }
    except Exception as e:
        logger.warning(f"YouTube fetch failed: {e}")
        return None

# ---------------- Auth ----------------
async def get_current_user(request: Request,
                           session_token: Optional[str] = Cookie(None),
                           authorization: Optional[str] = Header(None)):

    token = session_token

    if not token and authorization and authorization.startswith("Bearer "):
        token = authorization.split(" ", 1)[1]

    if not token:
        raise HTTPException(401, "Not authenticated")

    user_resp = supabase.table("users").select("*").limit(1).execute()

    if not user_resp.data:
        raise HTTPException(401, "User not found")

    return user_resp.data[0]

async def require_role(user: dict, role: str):
    if user.get("role") != role and user.get("role") != "ADMIN":
        raise HTTPException(403, f"Requires role: {role}")

# ---------------- Schemas ----------------
class SetRoleIn(BaseModel):
    role: str  # EDITOR | CREATOR

class UpdateProfileIn(BaseModel):
    username: Optional[str] = None
    display_name: Optional[str] = None
    bio: Optional[str] = None
    active_platforms: Optional[List[str]] = None
    is_earnings_public: Optional[bool] = None
    payout_upi: Optional[str] = None
    avatar_url: Optional[str] = None
    socials: Optional[dict] = None  # {tiktok, youtube, instagram, twitter, discord}

class FeaturedClipIn(BaseModel):
    title: str
    platform: str  # YOUTUBE_SHORTS | TIKTOK | INSTAGRAM_REELS
    views: int = 0
    points: float = 0
    thumbnail_url: Optional[str] = None
    video_url: Optional[str] = None

class JoinCampaignIn(BaseModel):
    youtube_channel: str  # URL or @handle

class CashoutIn(BaseModel):
    amount: float

class CreateCampaignIn(BaseModel):
    title: str
    content_type: str
    description: str
    clip_guidelines: str = ""
    bounty_pool: float
    max_clips_per_editor: int = 10
    start_date: str
    end_date: str
    source_video_urls: List[str] = []
    allowed_platforms: List[str] = ["YOUTUBE_SHORTS", "TIKTOK", "INSTAGRAM_REELS"]
    # Brief
    brief: Optional[dict] = None  # { objective, target_audience, content_style, topics_focus, topics_avoid, hook_style, length_guidelines, caption_guidelines, video_type }
    # Assets
    assets: Optional[dict] = None  # { drive_links, raw_footage, logos, brand_assets, notes }
    # Funding split (optional; if absent computed from bounty_pool)
    editor_pool_pct: float = 60.0
    performance_pool_pct: float = 30.0
    bonus_pool_pct: float = 10.0
    # Lock window
    min_duration_days: int = 7
    early_close_penalty_pct: float = 20.0

class SubmitClipIn(BaseModel):
    campaign_id: str
    platform: str
    clip_url: str
    views: int
    retention_pct: float
    engagement_pct: float
    analytics_screen_path: Optional[str] = None

# ---------------- Auth routes ----------------
@api.post("/auth/session")
async def auth_session(request: Request, response: Response):
    body = await request.json()
    session_id = body.get("session_id")
    if not session_id:
        raise HTTPException(400, "session_id required")
    r = requests.get(EMERGENT_AUTH_SESSION_URL, headers={"X-Session-ID": session_id}, timeout=15)
    if r.status_code != 200:
        raise HTTPException(401, "Invalid session_id")
    data = r.json()
    email = data["email"]
    existing_resp = supabase.table("users").select("*").eq("email", email).execute()
    existing = existing_resp.data[0] if existing_resp.data else None
    if existing:
        user = existing
        supabase.table("users").update({
            "name": data.get("name"),
            "avatar_url": data.get("picture")
        }).eq("user_id", user["user_id"]).execute()
        user["name"] = data.get("name")
        user["avatar_url"] = data.get("picture")
    else:
        user = {
            "user_id": new_id("user"),
            "email": email,
            "name": data.get("name") or email.split("@")[0],
            "username": (data.get("name") or email.split("@")[0]).replace(" ", "_").lower() + "_" + uuid.uuid4().hex[:4],
            "avatar_url": data.get("picture"),
            "role": None,  # set during onboarding
            "bio": "",
            "lifetime_points": 0.0,
            "total_earnings": 0.0,
            "active_platforms": [],
            "is_earnings_public": False,
            "payout_upi": "",
            "created_at": now_iso(),
        }
        supabase.table("users").insert(user).execute()
    token = data["session_token"]
    expires = datetime.now(timezone.utc) + timedelta(days=7)
    # await db.user_sessions.insert_one({
    #     "user_id": user["user_id"], "session_token": token,
    #     "expires_at": expires.isoformat(), "created_at": now_iso(),
    # })
    
    response.set_cookie("session_token", token, httponly=True, secure=True,
                        samesite="none", path="/", max_age=7 * 24 * 60 * 60)
    return clean_doc(user)

@api.get("/auth/me")
async def auth_me(request: Request, session_token: Optional[str] = Cookie(None),
                  authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    return clean_doc(user)

@api.post("/auth/logout")
async def auth_logout(response: Response, session_token: Optional[str] = Cookie(None)):
    if session_token:
        await db.user_sessions.delete_one({"session_token": session_token})
    response.delete_cookie("session_token", path="/")
    return {"ok": True}

@api.post("/auth/set-role")
async def set_role(payload: SetRoleIn, request: Request,
                   session_token: Optional[str] = Cookie(None),
                   authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    if payload.role not in ("EDITOR", "CREATOR"):
        raise HTTPException(400, "Invalid role")
    supabase.table("users").update({
    "role": payload.role
    }).eq("user_id", user["user_id"]).execute()
    user["role"] = payload.role
    return clean_doc(user)

@api.put("/auth/profile")
async def update_profile(payload: UpdateProfileIn, request: Request,
                         session_token: Optional[str] = Cookie(None),
                         authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    upd = {k: v for k, v in payload.model_dump(exclude_none=True).items()}
    # username uniqueness
    if "username" in upd and upd["username"] != user.get("username"):
        if await db.users.find_one({"username": upd["username"], "user_id": {"$ne": user["user_id"]}}, {"_id": 0}):
            raise HTTPException(400, "Username already taken")
    if "bio" in upd and len(upd["bio"]) > 160:
        raise HTTPException(400, "Bio too long (max 160)")
    if upd:
        await db.users.update_one({"user_id": user["user_id"]}, {"$set": upd})
    user2 = await db.users.find_one({"user_id": user["user_id"]}, {"_id": 0})
    return clean_doc(user2)

# ---------------- Featured clips on profile ----------------
@api.post("/profile/featured-clips")
async def add_featured_clip(payload: FeaturedClipIn, request: Request,
                            session_token: Optional[str] = Cookie(None),
                            authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    fc = user.get("featured_clips") or []
    if len(fc) >= 6:
        raise HTTPException(400, "Max 6 featured clips")
    item = dict(payload.model_dump())
    item["id"] = new_id("fc")
    fc.append(item)
    await db.users.update_one({"user_id": user["user_id"]}, {"$set": {"featured_clips": fc}})
    return item

@api.delete("/profile/featured-clips/{clip_id}")
async def remove_featured_clip(clip_id: str, request: Request,
                               session_token: Optional[str] = Cookie(None),
                               authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    fc = [c for c in (user.get("featured_clips") or []) if c.get("id") != clip_id]
    await db.users.update_one({"user_id": user["user_id"]}, {"$set": {"featured_clips": fc}})
    return {"ok": True}

# ---------------- Badges ----------------
BADGES = [
    {"id": "first_blood", "name": "First Blood", "icon": "🏆", "description": "Submitted your first clip"},
    {"id": "viral_hit",   "name": "Viral Hit",   "icon": "⚡", "description": "A clip crossed 100K views"},
    {"id": "hot_streak",  "name": "Hot Streak",  "icon": "🔥", "description": "Submitted clips in 3 campaigns consecutively"},
    {"id": "top_3",       "name": "Top 3 Finish","icon": "💎", "description": "Finished Top 3 in any campaign"},
    {"id": "winner",      "name": "Campaign Winner","icon":"👑", "description": "Finished #1 in a campaign"},
    {"id": "midnight",    "name": "Midnight Grinder","icon":"🌙","description": "Submitted a clip between 12am–4am"},
]

async def compute_badges(user_id: str):
    clips = await db.clips.find({"editor_id": user_id}, {"_id": 0}).to_list(2000)
    parts = await db.participations.find({"editor_id": user_id}, {"_id": 0}).to_list(2000)
    earned = set()
    if clips:
        earned.add("first_blood")
    if any(c.get("views", 0) >= 100_000 for c in clips):
        earned.add("viral_hit")
    if len(parts) >= 3:
        earned.add("hot_streak")
    ranks = [p.get("rank") for p in parts if p.get("rank")]
    if any(r <= 3 for r in ranks):
        earned.add("top_3")
    if any(r == 1 for r in ranks):
        earned.add("winner")
    for c in clips:
        ts = c.get("submitted_at", "")
        try:
            hour = datetime.fromisoformat(ts.replace("Z", "+00:00")).hour
            if 0 <= hour < 4:
                earned.add("midnight"); break
        except Exception:
            pass
    return [{**b, "earned": b["id"] in earned} for b in BADGES]

# ---------------- Public profile by username ----------------
async def build_public_profile(user: dict):
    uid = user["user_id"]
    clips = await db.clips.find({"editor_id": uid}, {"_id": 0}).to_list(2000)
    parts = await db.participations.find({"editor_id": uid}, {"_id": 0}).to_list(2000)
    total_views = sum(c.get("views", 0) for c in clips) + sum((fc.get("views") or 0) for fc in (user.get("featured_clips") or []))
    total_points = user.get("lifetime_points") or sum(c.get("points", 0) for c in clips)
    badges = await compute_badges(uid)
    # campaign history
    history = []
    for p in parts:
        c = await db.campaigns.find_one({"campaign_id": p["campaign_id"]}, {"_id": 0, "campaign_id": 1, "title": 1, "status": 1})
        if not c: continue
        history.append({
            "campaign_id": c["campaign_id"], "title": c["title"], "status": c["status"],
            "rank": p.get("rank"), "points": p.get("total_points", 0),
            "payout": p.get("payout_amount", 0),
        })
    history.sort(key=lambda x: (x.get("rank") or 999))
    return {
        "user_id": uid,
        "username": user.get("username"),
        "display_name": user.get("display_name") or user.get("name"),
        "name": user.get("name"),
        "avatar_url": user.get("avatar_url"),
        "bio": user.get("bio", ""),
        "role": user.get("role"),
        "socials": user.get("socials") or {},
        "featured_clips": user.get("featured_clips") or [],
        "total_views_generated": total_views,
        "total_points_earned": round(total_points, 2),
        "badges": badges,
        "campaign_history": history,
        "created_at": user.get("created_at"),
    }

@api.get("/profile/me/full")
async def my_full_profile(request: Request,
                          session_token: Optional[str] = Cookie(None),
                          authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    return await build_public_profile(user)

@api.get("/profile/by-username/{username}")
async def profile_by_username(username: str):
    user = await db.users.find_one({"username": username}, {"_id": 0})
    if not user:
        raise HTTPException(404, "User not found")
    p = await build_public_profile(user)
    # public view: never expose campaign history (per spec)
    p.pop("campaign_history", None)
    return p

# ---------------- Upload ----------------
@api.post("/wallet/cashout")
async def cashout(payload: CashoutIn, request: Request,
                  session_token: Optional[str] = Cookie(None),
                  authorization: Optional[str] = Header(None)):
    """MOCK cashout — debits user's total_earnings and creates a withdrawal record."""
    user = await get_current_user(request, session_token, authorization)
    amt = float(payload.amount)
    if amt <= 0:
        raise HTTPException(400, "Amount must be > 0")
    bal = float(user.get("total_earnings", 0))
    if amt > bal:
        raise HTTPException(400, f"Insufficient balance. Available: ₹{bal:.2f}")
    await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"total_earnings": -amt}})
    rec = {
        "withdrawal_id": new_id("wd"), "user_id": user["user_id"],
        "amount": round(amt, 2), "status": "COMPLETED",
        "razorpay_payout_id": f"pout_mock_{uuid.uuid4().hex[:8]}",
        "created_at": now_iso(),
    }
    await db.withdrawals.insert_one(dict(rec))
    return {"ok": True, "withdrawal": clean_doc(rec), "remaining_balance": round(bal - amt, 2)}

@api.get("/wallet/withdrawals")
async def list_withdrawals(request: Request,
                           session_token: Optional[str] = Cookie(None),
                           authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    docs = await db.withdrawals.find({"user_id": user["user_id"]}, {"_id": 0}).sort([("created_at", -1)]).to_list(200)
    return docs

@api.post("/upload")
async def upload_file(request: Request, file: UploadFile = File(...),
                      session_token: Optional[str] = Cookie(None),
                      authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    ext = (file.filename or "bin").rsplit(".", 1)[-1].lower()
    path = f"{APP_NAME}/uploads/{user['user_id']}/{uuid.uuid4().hex}.{ext}"
    data = await file.read()
    if len(data) > 8 * 1024 * 1024:
        raise HTTPException(400, "File too large (max 8MB)")
    result = put_object(path, data, file.content_type or "application/octet-stream")
    await db.files.insert_one({
        "file_id": new_id("file"), "owner_id": user["user_id"],
        "storage_path": result["path"], "original_filename": file.filename,
        "content_type": file.content_type, "size": result["size"],
        "is_deleted": False, "created_at": now_iso(),
    })
    return {"path": result["path"], "size": result["size"]}

@api.get("/files/{path:path}")
async def serve_file(path: str):
    data, ct = get_object(path)
    return Response(content=data, media_type=ct)

# ---------------- Campaigns ----------------
@api.get("/campaigns")
async def list_campaigns(status: Optional[str] = None, content_type: Optional[str] = None,
                         sort_by: str = "bounty_desc", mine: bool = False,
                         request: Request = None,
                         session_token: Optional[str] = Cookie(None),
                         authorization: Optional[str] = Header(None)):
    q = {}
    if status:
        q["status"] = status
    if content_type:
        q["content_type"] = content_type
    if mine:
        user = await get_current_user(request, session_token, authorization)
        q["creator_id"] = user["user_id"]
    sort_map = {
        "bounty_desc": [("bounty_pool", -1)],
        "ending_soon": [("end_date", 1)],
        "newest": [("created_at", -1)],
    }
    docs = await db.campaigns.find(q, {"_id": 0}).sort(sort_map.get(sort_by, [("bounty_pool", -1)])).to_list(100)
    # enrich with creator
    for d in docs:
        creator = await db.users.find_one({"user_id": d["creator_id"]}, {"_id": 0, "user_id": 1, "name": 1, "avatar_url": 1, "username": 1})
        d["creator"] = clean_doc(creator) if creator else None
        d["participant_count"] = await db.participations.count_documents({"campaign_id": d["campaign_id"]})
    return docs

@api.get("/campaigns/{campaign_id}")
async def get_campaign(campaign_id: str):
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not c:
        raise HTTPException(404, "Campaign not found")
    creator = await db.users.find_one({"user_id": c["creator_id"]}, {"_id": 0})
    c["creator"] = clean_doc(creator)
    c["participant_count"] = await db.participations.count_documents({"campaign_id": campaign_id})
    c["clip_count"] = await db.clips.count_documents({"campaign_id": campaign_id})
    return c

@api.post("/campaigns")
async def create_campaign(payload: CreateCampaignIn, request: Request,
                          session_token: Optional[str] = Cookie(None),
                          authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    await require_role(user, "CREATOR")
    cid = new_id("camp")
    fee = float(payload.bounty_pool) * PLATFORM_FEE / 100.0
    net = float(payload.bounty_pool) - fee
    doc = {
        "campaign_id": cid,
        "creator_id": user["user_id"],
        "title": payload.title,
        "content_type": payload.content_type,
        "description": payload.description,
        "clip_guidelines": payload.clip_guidelines,
        "bounty_pool": float(payload.bounty_pool),
        "max_clips_per_editor": payload.max_clips_per_editor,
        "platform_fee_percent": PLATFORM_FEE,
        "platform_fee_amount": round(fee, 2),
        "net_pool": round(net, 2),
        "editor_pool_pct": payload.editor_pool_pct,
        "performance_pool_pct": payload.performance_pool_pct,
        "bonus_pool_pct": payload.bonus_pool_pct,
        "min_duration_days": payload.min_duration_days,
        "early_close_penalty_pct": payload.early_close_penalty_pct,
        "escrow_funded": False,
        "escrow_order_id": None,
        "status": "DRAFT",
        "start_date": payload.start_date,
        "end_date": payload.end_date,
        "source_video_urls": payload.source_video_urls,
        "allowed_platforms": payload.allowed_platforms,
        "brief": payload.brief or {},
        "assets": payload.assets or {},
        "total_points": 0.0,
        "total_views": 0,
        "created_at": now_iso(),
    }
    await db.campaigns.insert_one(dict(doc))
    return clean_doc(doc)

@api.post("/campaigns/{campaign_id}/clone")
async def clone_campaign(campaign_id: str, request: Request,
                         session_token: Optional[str] = Cookie(None),
                         authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    await require_role(user, "CREATOR")
    src = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not src:
        raise HTTPException(404, "Not found")
    new_doc = dict(src)
    new_doc["campaign_id"] = new_id("camp")
    new_doc["creator_id"] = user["user_id"]
    new_doc["title"] = f"{src['title']} (Copy)"
    new_doc["status"] = "DRAFT"
    new_doc["escrow_funded"] = False
    new_doc["escrow_order_id"] = None
    new_doc["total_points"] = 0.0
    new_doc["total_views"] = 0
    new_doc["created_at"] = now_iso()
    new_doc.pop("published_at", None)
    await db.campaigns.insert_one(dict(new_doc))
    return clean_doc(new_doc)

@api.post("/campaigns/{campaign_id}/publish")
async def publish_campaign(campaign_id: str, request: Request,
                           session_token: Optional[str] = Cookie(None),
                           authorization: Optional[str] = Header(None)):
    """Publish campaign — debits creator's wallet for the bounty pool (mock escrow)."""
    user = await get_current_user(request, session_token, authorization)
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not c:
        raise HTTPException(404, "Not found")
    if c["creator_id"] != user["user_id"]:
        raise HTTPException(403, "Not your campaign")
    if c["status"] != "DRAFT":
        raise HTTPException(400, "Already published")
    bal = float(user.get("wallet_balance", 0))
    if bal < c["bounty_pool"]:
        raise HTTPException(400, f"Insufficient wallet balance. Need ₹{c['bounty_pool']:.2f}, have ₹{bal:.2f}. Add funds first.")
    mock_order = f"order_mock_{uuid.uuid4().hex[:10]}"
    await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"wallet_balance": -c["bounty_pool"]}})
    await db.transactions.insert_one({
        "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "CAMPAIGN_FUNDING",
        "amount": -float(c["bounty_pool"]), "campaign_id": campaign_id,
        "description": f"Funded campaign '{c['title']}'", "created_at": now_iso(),
    })
    await db.campaigns.update_one({"campaign_id": campaign_id},
                                  {"$set": {"status": "OPEN", "escrow_funded": True,
                                            "escrow_order_id": mock_order,
                                            "published_at": now_iso()}})
    return {"campaign_id": campaign_id, "escrow_order_id": mock_order, "status": "OPEN"}

@api.post("/campaigns/{campaign_id}/cancel")
async def cancel_campaign(campaign_id: str, request: Request,
                          session_token: Optional[str] = Cookie(None),
                          authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not c or c["creator_id"] != user["user_id"]:
        raise HTTPException(403, "Forbidden")
    # Early-close penalty if within min_duration window after publish
    refund = 0.0
    penalty = 0.0
    if c.get("escrow_funded"):
        published = parse_dt(c.get("published_at"))
        min_days = int(c.get("min_duration_days", 7))
        early = published and (datetime.now(timezone.utc) - published).days < min_days
        pool = float(c.get("bounty_pool", 0))
        if early:
            penalty_pct = float(c.get("early_close_penalty_pct", 20.0))
            penalty = round(pool * penalty_pct / 100.0, 2)
            refund = round(pool - penalty, 2)
        else:
            refund = pool
        if refund > 0:
            await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"wallet_balance": refund}})
            await db.transactions.insert_one({
                "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "REFUND",
                "amount": refund, "campaign_id": campaign_id,
                "description": f"Refund for cancelled campaign '{c['title']}'"
                               + (f" (early-close penalty ₹{penalty:.2f})" if penalty > 0 else ""),
                "created_at": now_iso(),
            })
        if penalty > 0:
            await db.transactions.insert_one({
                "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "PENALTY",
                "amount": -penalty, "campaign_id": campaign_id,
                "description": f"Early-close penalty ({c.get('early_close_penalty_pct', 20)}%)",
                "created_at": now_iso(),
            })
    await db.campaigns.update_one({"campaign_id": campaign_id}, {"$set": {"status": "CANCELLED"}})
    return {"ok": True, "refund": refund, "penalty": penalty}

@api.post("/campaigns/{campaign_id}/approve-payout")
async def approve_payout(campaign_id: str, request: Request,
                         session_token: Optional[str] = Cookie(None),
                         authorization: Optional[str] = Header(None)):
    """Distribute payouts. Refund undistributed remainder to creator wallet."""
    user = await get_current_user(request, session_token, authorization)
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not c or c["creator_id"] != user["user_id"]:
        raise HTTPException(403, "Forbidden")
    if c["status"] not in ("OPEN", "CLOSING_SOON", "UNDER_REVIEW"):
        raise HTTPException(400, "Cannot payout this campaign yet")
    await recompute_campaign(campaign_id)
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    total = c.get("total_points", 0.0)
    fee_amt = float(c["bounty_pool"]) * PLATFORM_FEE / 100.0
    pool_net = float(c["bounty_pool"]) - fee_amt
    parts = await db.participations.find({"campaign_id": campaign_id}, {"_id": 0}).to_list(1000)
    distributed = 0.0
    for p in parts:
        share = (p["total_points"] / total) if total > 0 else 0.0
        amount = round(pool_net * share, 2)
        if amount <= 0: continue
        distributed += amount
        await db.participations.update_one(
            {"participation_id": p["participation_id"]},
            {"$set": {"reward_share_pct": round(share * 100, 2),
                      "payout_amount": amount, "payout_status": "COMPLETED"}})
        await db.payouts.insert_one({
            "payout_id": new_id("pay"), "campaign_id": campaign_id,
            "editor_id": p["editor_id"], "amount": amount,
            "status": "COMPLETED", "razorpay_payout_id": f"pout_mock_{uuid.uuid4().hex[:8]}",
            "created_at": now_iso(), "processed_at": now_iso(),
        })
        await db.users.update_one({"user_id": p["editor_id"]}, {"$inc": {"total_earnings": amount}})
        await db.transactions.insert_one({
            "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "PAYOUT",
            "amount": -amount, "campaign_id": campaign_id,
            "description": f"Payout to editor for '{c['title']}'",
            "created_at": now_iso(),
        })
    # Refund undistributed remainder
    leftover = round(pool_net - distributed, 2)
    if leftover > 0:
        await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"wallet_balance": leftover}})
        await db.transactions.insert_one({
            "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "REFUND",
            "amount": leftover, "campaign_id": campaign_id,
            "description": f"Unused funds refunded from '{c['title']}'",
            "created_at": now_iso(),
        })
    # Platform fee transaction record
    await db.transactions.insert_one({
        "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "PLATFORM_FEE",
        "amount": -round(fee_amt, 2), "campaign_id": campaign_id,
        "description": f"Platform fee ({PLATFORM_FEE}%) for '{c['title']}'",
        "created_at": now_iso(),
    })
    await db.campaigns.update_one({"campaign_id": campaign_id}, {"$set": {"status": "COMPLETED"}})
    return {"ok": True, "distributed": distributed, "refunded": leftover, "fee": fee_amt}

# ---------------- Creator Wallet ----------------
class AddFundsIn(BaseModel):
    amount: float

@api.post("/wallet/add-funds")
async def add_funds(payload: AddFundsIn, request: Request,
                    session_token: Optional[str] = Cookie(None),
                    authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    amt = float(payload.amount)
    if amt <= 0:
        raise HTTPException(400, "Amount must be > 0")
    await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"wallet_balance": amt}})
    await db.transactions.insert_one({
        "tx_id": new_id("tx"), "user_id": user["user_id"], "type": "TOP_UP",
        "amount": amt, "description": "Wallet top-up (mock)",
        "razorpay_payment_id": f"pay_mock_{uuid.uuid4().hex[:10]}",
        "created_at": now_iso(),
    })
    user2 = await db.users.find_one({"user_id": user["user_id"]}, {"_id": 0})
    return {"ok": True, "balance": user2.get("wallet_balance", 0)}

@api.get("/wallet/transactions")
async def wallet_transactions(request: Request, limit: int = 100,
                              session_token: Optional[str] = Cookie(None),
                              authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    docs = await db.transactions.find({"user_id": user["user_id"]}, {"_id": 0}).sort([("created_at", -1)]).limit(limit).to_list(limit)
