@api.get("/wallet/creator-summary")
async def creator_wallet_summary(request: Request,
                                 session_token: Optional[str] = Cookie(None),
                                 authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    camps = await db.campaigns.find({"creator_id": user["user_id"]}, {"_id": 0}).to_list(500)
    spend = 0.0
    pending = 0.0
    in_escrow = 0.0
    for c in camps:
        if c.get("escrow_funded"):
            if c["status"] == "COMPLETED":
                spend += float(c.get("bounty_pool", 0))
            elif c["status"] in ("OPEN", "CLOSING_SOON", "UNDER_REVIEW"):
                in_escrow += float(c.get("bounty_pool", 0))
                pending += float(c.get("bounty_pool", 0))
    return {
        "balance": round(float(user.get("wallet_balance", 0)), 2),
        "total_spend": round(spend, 2),
        "in_escrow": round(in_escrow, 2),
        "pending_payouts": round(pending, 2),
    }

# ---------------- Creator Dashboard ----------------
def _tier(points: float) -> str:
    if points >= 50000: return "DIAMOND"
    if points >= 20000: return "PLATINUM"
    if points >= 10000: return "GOLD"
    if points >= 5000:  return "SILVER"
    if points >= 1000:  return "BRONZE"
    return "ROOKIE"

def _elo(points: float) -> int:
    # simple deterministic mapping
    return int(1000 + min(points, 50000) * 0.06)

@api.get("/dashboard/creator")
async def creator_dashboard(request: Request,
                            session_token: Optional[str] = Cookie(None),
                            authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    await require_role(user, "CREATOR")
    camps = await db.campaigns.find({"creator_id": user["user_id"]}, {"_id": 0}).to_list(500)
    camp_ids = [c["campaign_id"] for c in camps]
    clips = await db.clips.find({"campaign_id": {"$in": camp_ids}}, {"_id": 0}).to_list(5000)

    total_views = sum(c.get("views", 0) for c in clips)
    total_clips = len(clips)
    editors_set = {c["editor_id"] for c in clips}
    avg_ret = round(sum(c.get("retention_pct", 0) for c in clips) / len(clips), 2) if clips else 0.0
    total_spend = sum(float(c.get("bounty_pool", 0)) for c in camps if c.get("escrow_funded"))

    # Top performing clips
    top_clips = sorted(clips, key=lambda x: x.get("points", 0), reverse=True)[:6]
    enriched_clips = []
    for cl in top_clips:
        ed = await db.users.find_one({"user_id": cl["editor_id"]}, {"_id": 0, "name": 1, "username": 1, "avatar_url": 1, "user_id": 1})
        enriched_clips.append({
            "clip_id": cl["clip_id"], "clip_url": cl["clip_url"], "platform": cl["platform"],
            "views": cl["views"], "retention_pct": cl["retention_pct"],
            "engagement_pct": cl["engagement_pct"], "points": cl["points"],
            "thumbnail": (cl.get("yt_meta") or {}).get("thumbnail"),
            "editor": clean_doc(ed) if ed else None,
        })

    # Top editors aggregation
    by_editor = {}
    for cl in clips:
        e = by_editor.setdefault(cl["editor_id"], {"views": 0, "points": 0, "earnings": 0.0, "clips": 0})
        e["views"] += cl.get("views", 0)
        e["points"] += cl.get("points", 0)
        e["clips"] += 1
    # earnings via participations
    parts_all = await db.participations.find({"campaign_id": {"$in": camp_ids}}, {"_id": 0}).to_list(5000)
    for p in parts_all:
        if p["editor_id"] in by_editor:
            by_editor[p["editor_id"]]["earnings"] += float(p.get("payout_amount", 0))
    top_editors = sorted(by_editor.items(), key=lambda x: x[1]["points"], reverse=True)[:6]
    enriched_editors = []
    for eid, agg in top_editors:
        ed = await db.users.find_one({"user_id": eid}, {"_id": 0})
        lp = float((ed or {}).get("lifetime_points", 0))
        enriched_editors.append({
            "editor": clean_doc(ed) if ed else None,
            "views_generated": agg["views"],
            "earnings_generated": round(agg["earnings"], 2),
            "points": round(agg["points"], 2),
            "elo": _elo(lp), "tier": _tier(lp),
        })

    # Timeline by month for last 6 months
    from collections import defaultdict
    bucket = defaultdict(lambda: {"views": 0, "clips": 0, "points": 0})
    for cl in clips:
        ts = cl.get("submitted_at", "")
        try:
            dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            key = dt.strftime("%Y-%m")
            bucket[key]["views"] += cl.get("views", 0)
            bucket[key]["clips"] += 1
            bucket[key]["points"] += cl.get("points", 0)
        except Exception:
            pass
    timeline = [{"month": k, **v} for k, v in sorted(bucket.items())][-6:]

    # Content type distribution (for pie)
    type_dist = defaultdict(int)
    for c in camps:
        type_dist[c.get("content_type", "OTHER")] += 1

    return {
        "stats": {
            "total_views": total_views,
            "total_clips": total_clips,
            "total_editors": len(editors_set),
            "avg_retention": avg_ret,
            "total_spend": round(total_spend, 2),
        },
        "top_clips": enriched_clips,
        "top_editors": enriched_editors,
        "timeline": timeline,
        "content_type_distribution": [{"name": k, "value": v} for k, v in type_dist.items()],
    }

# ---------------- Talent (editor discovery) ----------------
@api.get("/talent")
async def talent(niche: Optional[str] = None, tier: Optional[str] = None,
                 min_lifetime_views: int = 0, min_retention: float = 0.0,
                 sort_by: str = "elo_desc"):
    users = await db.users.find({"role": "EDITOR"}, {"_id": 0}).to_list(500)
    out = []
    for u in users:
        uid = u["user_id"]
        clips = await db.clips.find({"editor_id": uid}, {"_id": 0}).to_list(2000)
        lifetime_views = sum(c.get("views", 0) for c in clips)
        avg_ret = round(sum(c.get("retention_pct", 0) for c in clips) / len(clips), 2) if clips else 0.0
        camps_completed = await db.participations.count_documents({"editor_id": uid})
        lp = float(u.get("lifetime_points", 0))
        t = _tier(lp)
        if tier and t != tier: continue
        if niche and niche.lower() not in (u.get("bio", "") or "").lower(): continue
        if lifetime_views < min_lifetime_views: continue
        if avg_ret < min_retention: continue
        out.append({
            "user_id": uid, "name": u.get("display_name") or u.get("name"),
            "username": u.get("username"), "avatar_url": u.get("avatar_url"),
            "bio": u.get("bio", ""),
            "lifetime_points": lp, "elo": _elo(lp), "tier": t,
            "lifetime_views": lifetime_views, "lifetime_earnings": float(u.get("total_earnings", 0)),
            "avg_retention": avg_ret, "campaigns_completed": camps_completed,
        })
    if sort_by == "elo_desc":
        out.sort(key=lambda x: x["elo"], reverse=True)
    elif sort_by == "views_desc":
        out.sort(key=lambda x: x["lifetime_views"], reverse=True)
    elif sort_by == "retention_desc":
        out.sort(key=lambda x: x["avg_retention"], reverse=True)
    return out

# ---------------- Participations ----------------
@api.post("/campaigns/{campaign_id}/join")
async def join_campaign(payload: JoinCampaignIn, campaign_id: str, request: Request,
                        session_token: Optional[str] = Cookie(None),
                        authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    await require_role(user, "EDITOR")
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    if not c:
        raise HTTPException(404, "Not found")
    if c["status"] not in ("OPEN", "CLOSING_SOON"):
        raise HTTPException(400, "Campaign not joinable")
    channel = fetch_youtube_channel(payload.youtube_channel)
    if not channel:
        raise HTTPException(400, "Could not resolve YouTube channel. Paste full channel URL or @handle.")
    existing = await db.participations.find_one({"campaign_id": campaign_id, "editor_id": user["user_id"]}, {"_id": 0})
    if existing:
        await db.participations.update_one(
            {"participation_id": existing["participation_id"]},
            {"$set": {"yt_channel": channel}})
        existing["yt_channel"] = channel
        return clean_doc(existing)
    doc = {
        "participation_id": new_id("part"),
        "campaign_id": campaign_id,
        "editor_id": user["user_id"],
        "yt_channel": channel,
        "joined_at": now_iso(),
        "total_points": 0.0,
        "rank": None,
        "reward_share_pct": None,
        "payout_amount": 0.0,
        "payout_status": "PENDING",
    }
    await db.participations.insert_one(dict(doc))
    return clean_doc(doc)

# ---------------- Clips ----------------
async def recompute_campaign(campaign_id: str):
    clips = await db.clips.find({"campaign_id": campaign_id}, {"_id": 0}).to_list(10000)
    editor_totals = {}
    total = 0.0
    for clip in clips:
        editor_totals[clip["editor_id"]] = editor_totals.get(clip["editor_id"], 0.0) + clip["points"]
        total += clip["points"]
    await db.campaigns.update_one({"campaign_id": campaign_id}, {"$set": {"total_points": round(total, 2)}})
    # update participations and ranks
    sorted_parts = sorted(editor_totals.items(), key=lambda x: x[1], reverse=True)
    for rank, (editor_id, pts) in enumerate(sorted_parts, start=1):
        share = (pts / total * 100) if total > 0 else 0.0
        await db.participations.update_one(
            {"campaign_id": campaign_id, "editor_id": editor_id},
            {"$set": {"total_points": round(pts, 2), "rank": rank, "reward_share_pct": round(share, 2)}})

@api.post("/clips")
async def submit_clip(payload: SubmitClipIn, request: Request,
                      session_token: Optional[str] = Cookie(None),
                      authorization: Optional[str] = Header(None)):
    user = await get_current_user(request, session_token, authorization)
    await require_role(user, "EDITOR")
    c = await db.campaigns.find_one({"campaign_id": payload.campaign_id}, {"_id": 0})
    if not c:
        raise HTTPException(404, "Campaign not found")
    if c["status"] not in ("OPEN", "CLOSING_SOON"):
        raise HTTPException(400, "Campaign not accepting clips")
    # ensure joined
    part = await db.participations.find_one({"campaign_id": payload.campaign_id, "editor_id": user["user_id"]}, {"_id": 0})
    if not part:
        raise HTTPException(400, "Join the campaign first")
    existing_count = await db.clips.count_documents({"campaign_id": payload.campaign_id, "editor_id": user["user_id"]})
    if existing_count >= c["max_clips_per_editor"]:
        raise HTTPException(400, "Max clips reached")

    pts = calc_points(payload.views, payload.retention_pct, payload.engagement_pct)
    yt_meta = fetch_youtube_stats(payload.clip_url) if payload.platform == "YOUTUBE_SHORTS" else None

    # Auto-verify clip channel matches editor's connected channel for this campaign
    if payload.platform == "YOUTUBE_SHORTS" and yt_meta and yt_meta.get("channel_id"):
        connected = (part or {}).get("yt_channel") or {}
        connected_id = connected.get("channel_id")
        connected_handle = (connected.get("handle") or "").lstrip("@").lower()
        clip_channel_id = yt_meta["channel_id"]
        clip_channel_title = (yt_meta.get("channel_title") or "").lower()
        ok = False
        if connected_id and connected_id == clip_channel_id:
            ok = True
        elif connected_handle and connected_handle in clip_channel_title:
            ok = True
        if not ok:
            raise HTTPException(
                400,
                f"Channel mismatch — clip is from '{yt_meta.get('channel_title')}' "
                f"but your connected channel is '{connected.get('title') or connected.get('handle')}'. "
                f"Upload from your connected channel or reconnect a different channel for this campaign."
            )

    doc = {
        "clip_id": new_id("clip"),
        "campaign_id": payload.campaign_id,
        "editor_id": user["user_id"],
        "platform": payload.platform,
        "clip_url": payload.clip_url,
        "views": payload.views,
        "retention_pct": payload.retention_pct,
        "engagement_pct": payload.engagement_pct,
        "points": pts["points"],
        "retention_mult": pts["retention_mult"],
        "engagement_mult": pts["engagement_mult"],
        "hit_mult": pts["hit_mult"],
        "analytics_screen_path": payload.analytics_screen_path,
        "analytics_verified": bool(yt_meta),  # auto-verified if YT API confirmed
        "yt_meta": yt_meta,
        "submitted_at": now_iso(),
    }
    await db.clips.insert_one(dict(doc))
    await recompute_campaign(payload.campaign_id)
    # update lifetime points for editor
    total_lifetime = 0.0
    async for cl in db.clips.find({"editor_id": user["user_id"]}, {"_id": 0, "points": 1}):
        total_lifetime += cl["points"]
    await db.users.update_one({"user_id": user["user_id"]}, {"$set": {"lifetime_points": round(total_lifetime, 2)}})
    return clean_doc(doc)

@api.get("/clips")
async def list_clips(campaign_id: Optional[str] = None, editor_id: Optional[str] = None):
    q = {}
    if campaign_id: q["campaign_id"] = campaign_id
    if editor_id: q["editor_id"] = editor_id
    clips = await db.clips.find(q, {"_id": 0}).sort([("submitted_at", -1)]).to_list(500)
    for cl in clips:
        ed = await db.users.find_one({"user_id": cl["editor_id"]}, {"_id": 0, "user_id": 1, "name": 1, "username": 1, "avatar_url": 1})
        cl["editor"] = clean_doc(ed) if ed else None
    return clips

@api.post("/youtube/fetch")
async def youtube_fetch(payload: dict, request: Request,
                        session_token: Optional[str] = Cookie(None),
                        authorization: Optional[str] = Header(None)):
    _ = await get_current_user(request, session_token, authorization)
    meta = fetch_youtube_stats(payload.get("clip_url", ""))
    if not meta:
        return {"ok": False, "message": "Could not fetch. Enter analytics manually."}
    # estimated engagement %: (likes+comments)/views *100
    engagement = 0.0
    if meta["views"] > 0:
        engagement = round((meta["likes"] + meta["comments"]) / meta["views"] * 100.0, 2)
    return {"ok": True, "views": meta["views"], "likes": meta["likes"],
            "comments": meta["comments"], "engagement_pct": engagement,
            "title": meta["title"]}

# ---------------- Leaderboard ----------------
@api.get("/leaderboard/campaign/{campaign_id}")
async def leaderboard_campaign(campaign_id: str):
    parts = await db.participations.find({"campaign_id": campaign_id}, {"_id": 0}).sort([("total_points", -1)]).to_list(200)
    c = await db.campaigns.find_one({"campaign_id": campaign_id}, {"_id": 0})
    pool_net = (c["bounty_pool"] * (1 - PLATFORM_FEE / 100.0)) if c else 0.0
    total = c.get("total_points", 0.0) if c else 0.0
    out = []
    for i, p in enumerate(parts, start=1):
        ed = await db.users.find_one({"user_id": p["editor_id"]}, {"_id": 0, "user_id": 1, "name": 1, "username": 1, "avatar_url": 1})
        clips = await db.clips.find({"campaign_id": campaign_id, "editor_id": p["editor_id"]}, {"_id": 0}).to_list(100)
        best = max(clips, key=lambda x: x["points"], default=None)
        share = (p["total_points"] / total) if total > 0 else 0.0
        out.append({
            "rank": i, "editor": clean_doc(ed),
            "yt_channel": p.get("yt_channel"),
            "total_points": p["total_points"], "clips_submitted": len(clips),
            "best_clip": {"points": best["points"], "views": best["views"]} if best else None,
            "reward_share_pct": round(share * 100, 2),
            "projected_payout": round(pool_net * share, 2),
        })
    return out

@api.get("/leaderboard/lifetime")
async def leaderboard_lifetime(limit: int = 25):
    users = await db.users.find({"role": "EDITOR"}, {"_id": 0}).sort([("lifetime_points", -1)]).limit(limit).to_list(limit)
    out = []
    for i, u in enumerate(users, start=1):
        out.append({"rank": i, "editor": clean_doc(u),
                    "lifetime_points": u.get("lifetime_points", 0.0),
                    "total_earnings": u.get("total_earnings", 0.0)})
    return out

@api.get("/leaderboard/monthly")
async def leaderboard_monthly(limit: int = 25):
    start = datetime.now(timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    pipeline = [
        {"$match": {"submitted_at": {"$gte": start.isoformat()}}},
        {"$group": {"_id": "$editor_id", "points": {"$sum": "$points"}, "clips": {"$sum": 1}}},
        {"$sort": {"points": -1}}, {"$limit": limit},
    ]
    docs = await db.clips.aggregate(pipeline).to_list(limit)
    out = []
    for i, d in enumerate(docs, start=1):
        ed = await db.users.find_one({"user_id": d["_id"]}, {"_id": 0})
        out.append({"rank": i, "editor": clean_doc(ed),
                    "monthly_points": round(d["points"], 2), "clips": d["clips"]})
    return out

# ---------------- Dashboard ----------------
@api.get("/dashboard")
async def dashboard(request: Request,
                    session_token: Optional[str] = Cookie(None),
                    authorization: Optional[str] = Header(None)):

    user = await get_current_user(request, session_token, authorization)

    return {
        "role": user.get("role"),
        "stats": {},
        "active_campaigns": [],
        "recent_clips": [],
        "my_campaigns": [],
        "top_editors": []
    }

# ---------------- Profile ----------------
@api.get("/users/{user_id}")
async def get_user_profile(user_id: str):
    u = await db.users.find_one({"user_id": user_id}, {"_id": 0})
    if not u:
        raise HTTPException(404, "Not found")
    if u.get("role") == "EDITOR":
        clips = await db.clips.find({"editor_id": user_id}, {"_id": 0}).sort([("points", -1)]).limit(12).to_list(12)
        camps_played = await db.participations.count_documents({"editor_id": user_id})
        u["clips"] = clips
        u["campaigns_played"] = camps_played
    elif u.get("role") == "CREATOR":
        camps = await db.campaigns.find({"creator_id": user_id}, {"_id": 0}).to_list(50)
        u["campaigns"] = camps
        total_paid = 0.0
        for c in camps:
            payouts = await db.payouts.find({"campaign_id": c["campaign_id"]}, {"_id": 0}).to_list(200)
            total_paid += sum(p.get("amount", 0) for p in payouts)
        u["total_paid_out"] = round(total_paid, 2)
    return clean_doc(u)

